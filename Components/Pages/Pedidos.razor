<!-- TERMINADA Y FUNCIONANDO -->

@page "/pedidos"
@rendermode InteractiveServer
@using Restaurante.Data
@using Restaurante.Models
@inject RestauranteDbContext db
@inject HttpClient Http
@inject IJSRuntime JS

<main class="orders-screen py-5">
    <div class="container">

        <!-- Encabezado de la Pantalla -->
        <div class="text-center mb-5">
            <span class="orders-subtitle">Bitácora de Servicio</span>
            <h1 class="orders-main-title">Comandas y Pedidos</h1>
            <div class="orders-divider"></div>
        </div>

        <!-- Formulario para agregar un nuevo pedido -->
        <div class="orders-card mb-5">
            <h2 class="panel-title mb-4"><i class="bi bi-plus-circle-fill me-2 text-gold"></i>Registrar Consumo</h2>

            <form id="orderForm" onsubmit="@AgregarPedido">
                <div class="row g-4">

                    <!-- Select vincular ID de reservación -->
                    <div class="col-md-3">
                        <label for="reservaId" class="orders-label">Vincular Reservación</label>
                        <div class="orders-field-wrapper">
                            <i class="bi bi-journal-bookmark orders-icon-left"></i>
                            <select id="reservaId" class="orders-control-select" @bind="nuevoPedido.ReservacionId" required>
                                <option value="0" disabled selected hidden>No. Reservación</option>
                                @foreach (var res in reservaciones)
                                {
                                    <option value="@res.Id">Reserva #@res.Id</option>
                                }
                            </select>
                            <i class="bi bi-chevron-down orders-icon-right"></i>
                        </div>
                    </div>

                    <!-- Select para escoger platillo o bebida -->
                    <div class="col-md-4">
                        <label for="platilloId" class="orders-label">Platillo / Bebida</label>
                        <div class="orders-field-wrapper">
                            <select id="platilloId" class="orders-control-select" @bind="nuevoPedido.ProductoApiId" required>
                                <option value="0" disabled selected hidden>Seleccione del menú...</option>
                                @if (products != null)
                                {
                                    @foreach (var prod in products)
                                    {
                                        <option value="@prod.Id">@prod.Nombre </option>
                                    }
                                }
                            </select>
                            <i class="bi bi-chevron-down orders-icon-right"></i>
                        </div>
                    </div>

                    <!-- Cantidad de pedidos -->
                    <div class="col-md-2">
                        <label for="cantidad" class="orders-label">Cantidad</label>
                        <div class="orders-field-wrapper">
                            <i class="bi bi-hash orders-icon-left"></i>
                            <input type="number" @bind-value="nuevoPedido.Cantidad" id="cantidad" class="orders-control ps-5" min="1" @bind-value:event="oninput" required>
                        </div>
                    </div>

                    <!-- Precio total -->
                    <div class="col-md-3">
                        <label for="precioTotal" class="orders-label">Precio Total</label>
                        <div class="orders-field-wrapper">
                            <span class="currency-prefix">$</span>
                            <!-- No se edita el precio, se calcula, muestra y guarda -->
                            <input type="number" value="@PrecioTotalNuevo" id="precioTotal" class="orders-control currency-padding" readonly>
                            <span class="currency-suffix">MXN</span>
                        </div>
                    </div>

                </div>

                <!-- Botón de Envío -->
                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn-orders-submit">
                        <i class="bi bi-send-fill me-2"></i> Agregar Pedido
                    </button>
                </div>
            </form>
        </div>

        <!-- Tabla donde se muestran los datos de la tabla Pedidos. -->

        @if (products == null)
        {
            <div class="spinner-container text-center">
                <p>Cargando pedidos...</p>
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {
            @if (pedidos.Count != 0)
            {
                <div class="orders-card">
                    <h2 class="panel-title mb-4"><i class="bi bi-list-stars me-2 text-gold"></i>Pedidos Activos en Sala</h2>
                    <div class="table-responsive">
                        <table class="table orizon-table align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">ID Reserva</th>
                                    <th scope="col">Platillo</th>
                                    <th scope="col" class="text-center">Cantidad</th>
                                    <th scope="col" class="text-end">Total Consumido</th>
                                    <th scope="col" class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pedido in pedidos)
                                {
                                    // Busca el platillo específico de la lista. Si products está vacia devuelve null. Sino, busca el primer valor de la lista de productos de la API que sea igual al Id de ProductoApiId de Pedidos. Si no encuentra nignuno, regresa null.
                                    var platilloPedido = products?.FirstOrDefault(p => p.Id == pedido.ProductoApiId);

                                    <tr>
                                        <td><span class="badge-reserva">#@pedido.ReservacionId</span></td>

                                        <td class="fw-bold text-navy">
                                            @if (platilloPedido != null)
                                            {
                                                @platilloPedido.Nombre
                                            }
                                            else
                                            {
                                                <span class="text-danger">Producto no encontrado</span>
                                            }
                                        </td>

                                        <td class="text-center fw-semibold text-navy">@pedido.Cantidad</td>

                                        <td class="text-end fw-bold text-gold">$ @pedido.Precio</td>
                                        <td class="text-center">
                                            <div class="btn-group-actions">
                                                <button class="btn-action-edit" @onclick="() => EditarPedido(pedido)" title="Editar Pedido"><i class="bi bi-pencil-square"></i></button>
                                                <button class="btn-action-delete" @onclick="() => EliminarPedido(pedido)" title="Eliminar Pedido"><i class="bi bi-trash3"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
        
        @if (pedidoEdicion != null)
        {
            <div class="orders-card mb-5 mt-5 panel-editing-mode" onsubmit="@GuardarEdicion">

                <h2 class="panel-title mb-4">
                    <i class="bi bi-pencil-fill me-2 text-gold"></i> Modificar Pedido
                </h2>

                <form id="orderForm" >
                    <div class="row g-4">

                        <!-- Input Reservación -->
                        <div class="col-md-3">
                            <label for="reservaId" class="orders-label">Vincular Reservación</label>
                            <div class="orders-field-wrapper">
                                <i class="bi bi-journal-bookmark orders-icon-left text-gold"></i>
                                <select id="reservaId" class="orders-control-select" @bind="pedidoEdicion.ReservacionId" required>
                                    <option value="0" disabled selected hidden>No. Reservación</option>
                                    @foreach (var res in reservaciones)
                                    {
                                        <option value="@res.Id">Reserva #@res.Id</option>
                                    }
                                </select>
                                <i class="bi bi-chevron-down orders-icon-right"></i>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label for="platilloId" class="orders-label">Platillo / Bebida</label>
                            <div class="orders-field-wrapper">
                                <select id="platilloId" class="orders-control-select" @bind="pedidoEdicion.ProductoApiId" required>
                                    <option value="0" disabled selected hidden>Seleccione del menú...</option>
                                    @if (products != null)
                                    {
                                        @foreach (var prod in products)
                                        {
                                            <option value="@prod.Id">@prod.Nombre </option>
                                        }
                                    }
                                </select>
                                <i class="bi bi-chevron-down orders-icon-right"></i>
                            </div>
                        </div>

                        <!-- Cantidad del producto -->
                        <div class="col-md-2">
                            <label for="cantidad" class="orders-label">Cantidad</label>
                            <div class="orders-field-wrapper">
                                <i class="bi bi-hash orders-icon-left text-gold"></i>
                                <input type="number" @bind-value="pedidoEdicion.Cantidad" id="cantidad" class="orders-control ps-5" min="1" @bind-value:event="oninput" required>
                            </div>
                        </div>

                        <!-- Precio total, no editable -->
                        <div class="col-md-3">
                            <label for="precioTotal" class="orders-label">Precio Total</label>
                            <div class="orders-field-wrapper">
                                <span class="currency-prefix text-gold">$</span>
                                <input type="number" value="@PrecioTotalEdicion" id="precioTotal" class="orders-control currency-padding" readonly>
                                <span class="currency-suffix">MXN</span>
                            </div>
                        </div>

                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <button type="button" class="btn-orders-cancel" @onclick="CancelarEdicion">
                            Cancelar
                        </button>

                        <button type="submit" class="btn-orders-update" @onclick="GuardarEdicion">
                            <i class="bi bi-check-circle-fill me-2"></i> Actualizar Comanda
                        </button>
                    </div>
                </form>
            </div>
        }

    </div>
</main>

@code {
    // Para iniciar edición.
    private Pedido? pedidoEdicion = null;

    // Modelos y Listas
    private Pedido nuevoPedido = new Pedido
    {
        ReservacionId = 0,
        ProductoApiId = 0,
        Cantidad = 1,
        Precio = 0.0m
    };

    private List<Productos_API>? products;
    private List<Reservacion> reservaciones = [];
    private List<Pedido> pedidos = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Pruebas cuando API no está disponible. Comentar cuando ya esté disponible.
            string url = "https://localhost:7244/data/platillosDisponibles.json";

            // API a descomentar cuando estén disponibles.
            //string url = $"https://api-udec-pweb-aedec9hxbugye0am.westus3-01.azurewebsites.net/api/alimentacion/platillos/disponibles";

            //Con HTTPCLIENT, inyectado arriba, envia una petición GET a la API. Deserializa, pasa de texto plano a objetos de la clase Productos_API y guarda la lista generada en products.
            products = await Http.GetFromJsonAsync<List<Productos_API>>(url);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al recuperar los datos: {ex.Message}");
        }
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        reservaciones = await db.Reservaciones.ToListAsync();

        // Tenía problemas que rompían la aplicación o hacía que funcionara mal (por el cálculo del precio). .AsNoTracking evita que EFCore vigile los cambios. Se utiliza, después, una variable para edición donde se guardan temporalmente los datos y, después, se guardan en la db. 
        pedidos = await db.Pedidos.AsNoTracking().ToListAsync();
    }

    private async Task CargarPedidos()
    {
        // Mismo cambio aquí por la misma razón.
        pedidos = await db.Pedidos.AsNoTracking().ToListAsync();
    }

    // ---- Nuevo pedido ---
    private decimal PrecioTotalNuevo
    {
        //Solo lectura, sin set. Se actualiza cuando se actualiza la cantidad de productos.
        get
        {
            // Se revisa si es null. Si no, se busca el primer producto de la lista products donde el id de dicho producto sea igual al id del producto registrado en el campo ProductoApiId del pedido.
            var producto = products?.FirstOrDefault(p => p.Id == nuevoPedido.ProductoApiId);

            // Si el producto es null, es 0. Sino, se multiplica la cantidad de productos por el costo del producto.
            return producto == null ? 0.00m : nuevoPedido.Cantidad * producto.Precio;
        }
    }

    private async Task AgregarPedido()
    {
        //Si no hay una reservación seleccionada o si no hay ningún producto (igual a 0, se valida que sea diferente), no se hace nada.
        if (nuevoPedido.ReservacionId != 0 && nuevoPedido.ProductoApiId != 0)
        {
            // Cálculo anterior del precio*cantidad de productos
            nuevoPedido.Precio = PrecioTotalNuevo;

            // Se agrega el seguimiento a este nuevo pedido (agrega una etiqueta para que dbcontext la reconozca y se inserten los datos en la siguiente línea)
            db.Pedidos.Add(nuevoPedido);
            
            //Hace la sentencia SQL para hacer los cambios.
            await db.SaveChangesAsync();

            //Espera a que la lista vuelva a cargarse.
            await CargarPedidos();

            // Reiniciar el modelo para el siguiente registro
            nuevoPedido = new Pedido
            {
                ReservacionId = 0,
                ProductoApiId = 0,
                Cantidad = 1,
                Precio = 0.0m
            };

            // Informa que se hizo cambios
            StateHasChanged();
        }
    }

    // ---- Edición de pedido ----

    //Se utiliza otro para edición porque, si se usara el mismo método, no se considera la cantidad que se está editando.

    private decimal PrecioTotalEdicion
    {
        //Igual que con el otro.
        get
        {
            if (pedidoEdicion != null)
            {
                //Hace el mismo cálculo de nuevo pero con la cantidad editada
                var producto = products?.FirstOrDefault(p => p.Id == pedidoEdicion.ProductoApiId);
                return producto == null ? 0.00m : pedidoEdicion.Cantidad * producto.Precio;
            }
            return 0.0m;
        }
    }

    private void EditarPedido(Pedido pedido)
    {
        // Se utiliza una copia de Pedido para guardar, temporalmente, los datos. Si sí se quiere guardar la edición, se hace la actualización. Si no, se borra.
        pedidoEdicion = new Pedido
        {
            Id = pedido.Id,
            ReservacionId = pedido.ReservacionId,
            ProductoApiId = pedido.ProductoApiId,
            Cantidad = pedido.Cantidad,
            Precio = pedido.Precio
        };
    }

    private async Task GuardarEdicion()
    {
        if (pedidoEdicion != null)
        {
            try
            {
                // Se guarda el precio calculado de edición
                pedidoEdicion.Precio = PrecioTotalEdicion;

                // Se marca que el objeto se editó (lo marca como cambiado, no como nuevo como lo hace con Add; sustitución manual para el tracker que si quitó con AsNoTracking) y se genera la sentencia SQL
                db.Pedidos.Update(pedidoEdicion);
                await db.SaveChangesAsync();

                // Se cierra la edición.
                pedidoEdicion = null;

                // Espera a que se recarge la tabla y se informa del cambio.
                await CargarPedidos();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al guardar edición: {ex.Message}");
            }
        }
    }

    private async Task CancelarEdicion()
    {
        //Solo se destruye la copia temporal. No se guarda en la db.
        pedidoEdicion = null;
        await CargarPedidos();
        StateHasChanged();
    }

    // ---- Eliminar registro ----
    private async Task EliminarPedido(Pedido pedido)
    {
        bool seguro = await JS.InvokeAsync<bool>("confirm", $"¿Seguro que desea eliminar el pedido?");

        // Si el usuario presiona "Cancelar", 'seguro' será false y el código se detiene aquí
        if (!seguro) return;

        try
        {
            // Elimina el objeto seleccionado.
            db.Pedidos.Remove(pedido);
            await db.SaveChangesAsync();
            await CargarPedidos();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar: {ex.Message}");
        }
    }
}