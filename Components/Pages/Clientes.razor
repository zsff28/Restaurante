@page "/clientes"
@rendermode InteractiveServer
@using Restaurante.Models
@using Restaurante.Data
@inject RestauranteDbContext db
@inject IJSRuntime JS

<div class="container-fluid px-4 py-5">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <span class="view-meta-tag">Registro de Matrículas</span>
            <h1 class="view-title m-0">Directorio de Clientes VIP</h1>
            <p class="view-subtitle text-muted m-0">Historial de miembros exclusivos y tripulación registrada</p>
        </div>
        <a href="/regClientes" class="btn-orizon-action">
            <i class="bi bi-person-plus-fill me-2"></i> Registrar Miembro
        </a>
    </div>

    <div class="orizon-client-card">
        <div class="table-responsive">
            <table class="table orizon-custom-table align-middle">
                <thead>
                    <tr>
                        <th scope="col" style="width: 8%;">ID</th>
                        <th scope="col" style="width: 32%;">Nombre del Miembro</th>
                        <th scope="col" style="width: 20%;">Teléfono</th>
                        <th scope="col" style="width: 25%;">Correo Electrónico</th>
                        <th scope="col" style="width: 15%;">Fecha Registro</th>
                        <th scope="col" style="width: 10%;" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (listaClientes == null)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                <div class="spinner-border text-primary" role="status"></div>
                                <p class="text-muted mt-2">Cargando clientes de Orizon...</p>
                            </td>
                        </tr>
                    }
                    else if (!listaClientes.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No hay miembros registrados en el directorio.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var cliente in listaClientes)
                        {
                            <tr>
                                <!-- Formatea la salida para que sean 4 dígitos, agregando 0 a la izquierda por estética. -->
                                <td><span class="client-id-tag">#@cliente.Id.ToString("D4")</span></td>
                                <td>
                                    <div class="client-profile-box d-flex align-items-center">
                                        <div class="ms-3">
                                            <div class="client-main-name">@cliente.Nombre</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="contact-item">
                                        <i class="bi bi-telephone text-gold me-2"></i>@cliente.Telefono
                                    </span>
                                </td>
                                <td>
                                    <span class="contact-item text-lowercase">
                                        <i class="bi bi-envelope text-gold me-2"></i>@cliente.Email
                                    </span>
                                </td>
                                <td>
                                    <!-- Formatea el la fecha de salida para mostrarse como dia mes, año, agregando al día un 0 si la fecha es de un dígito (queda de dos siempre), además de mostrar la abreviatura del mes. -->
                                    <div class="registration-date">@cliente.FechaRegistro.ToString("dd MMM, yyyy")</div>
                                </td>
                                <td class="text-end">
                                    <div class="client-actions-wrapper">
                                        <!-- Botón para editar registro de cliente -->
                                        <button class="btn-client-edit" title="Editar Expediente" @onclick="() => EditarExpediente(cliente)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <!-- Botón para eliminar registro de cliente -->
                                        <button class="btn-client-delete" title="Dar de Baja" @onclick="() => DarDeBajaCliente(cliente)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Formulario de Edición de Expedientes -->
@if (clienteEdicion != null)
{
    <div class="orizon-client-edit-card mt-5 mb-5">
        <div class="edit-header d-flex align-items-center mb-4">
            <div class="edit-nav-indicator"></div>
            <div>
                <h3 class="edit-title m-0">Modificar Expediente de Miembro</h3>
                <p class="edit-subtitle m-0 text-muted">Actualizando credenciales de tripulación y contacto</p>
            </div>
        </div>

        <form @onsubmit="GuardarEdicion">
            <div class="row g-4">

                <div class="col-md-6">
                    <label for="editClientName" class="form-orizon-label">Nombre Completo</label>
                    <div class="form-orizon-wrapper">
                        <i class="bi bi-person-vcard form-orizon-icon-left"></i>
                        <input type="text" id="editClientName" class="form-orizon-control input-edit-focus"
                            @bind="clienteEdicion.Nombre" required>
                    </div>
                </div>

                <div class="col-md-6">
                    <label for="editClientPhone" class="form-orizon-label">Teléfono de Contacto</label>
                    <div class="form-orizon-wrapper">
                        <i class="bi bi-telephone form-orizon-icon-left"></i>
                        <!-- Sincroniza la propiedad interna value de Radzen. Como es una librería externa, utiliza bind-value y no solo bind (forma abreviada de bind-value) -->
                        <RadzenMask @bind-value="clienteEdicion.Telefono" Mask="***-***-****" CharacterPattern="[0-9]" id="editClientPhone" class="w-100" required />
                    </div>
                </div>

                <div class="col-md-6">
                    <label for="editClientEmail" class="form-orizon-label">Correo Electrónico</label>
                    <div class="form-orizon-wrapper">
                        <i class="bi bi-envelope form-orizon-icon-left"></i>
                        <input type="email" id="editClientEmail" class="form-orizon-control input-edit-focus text-lowercase" @bind="clienteEdicion.Email" required>
                    </div>
                </div>

                <div class="col-md-6">
                    <label for="editClientRegDate" class="form-orizon-label">Fecha de Alta en Bitácora</label>
                    <div class="form-orizon-wrapper">
                        <i class="bi bi-calendar-check form-orizon-icon-left"></i>
                        <input type="date" id="editClientRegDate" class="form-orizon-control input-edit-focus"
                            @bind="clienteEdicion.FechaRegistro" required>
                    </div>
                </div>

            </div>

            <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top border-light">
                <button type="button" class="btn-orizon-secondary" @onclick="CancelarEdicion">
                    Cancelar Cambios
                </button>
                <button type="submit" class="btn-orizon-accent" @onclick="GuardarEdicion"> 
                    Actualizar
                </button>
            </div>
        </form>
    </div>
}

@code {
    //Variable para verificar si se está editando
    private Cliente? clienteEdicion = null;

    //Nueva lista de objetos de cliente
    private List<Cliente> listaClientes = [];

    //Se ejecuta cuando el componente se carga.
    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        // Se carga la lista completa de la base de datos en listaClientes. Con el await la aplicación no se congela, se carga la lista y luego continúa con el código.
        listaClientes = await db.Clientes.ToListAsync();
    }


    private void EditarExpediente(Cliente cliente)
    {
        // Se clona el cliente para que los cambios en pantalla no afecten la lista global prematuramente
        clienteEdicion = new Cliente
        {
            Id = cliente.Id,
            Nombre = cliente.Nombre,
            Telefono = cliente.Telefono,
            Email = cliente.Email,
            FechaRegistro = cliente.FechaRegistro
        };
    }

    private async Task GuardarEdicion()
    {
        if (clienteEdicion != null)
        {
            try
            {
                // Se busca el id del cliente que se está editando (el original, no el registro "copiado") y se guarda en la variable. Con FindAsync se busca el cliente primero en la memoria caché.
                var clienteOriginal = await db.Clientes.FindAsync(clienteEdicion.Id);

                if (clienteOriginal != null)
                {
                    // Se copian los valores actualizados del formulario al cliente original
                    clienteOriginal.Nombre = clienteEdicion.Nombre;
                    clienteOriginal.Telefono = clienteEdicion.Telefono;
                    clienteOriginal.Email = clienteEdicion.Email;
                    clienteOriginal.FechaRegistro = clienteEdicion.FechaRegistro;

                    // Detecta los cambios y genera el SQL para guardar en la base de datos
                    await db.SaveChangesAsync();
                }

                // Se oculta el formulario, cargan los clientes de nuevo y se informa que el estado del servidor ha cambiado.
                clienteEdicion = null;
                await CargarClientes();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al actualizar el expediente del cliente: {ex.Message}");
            }
        }
    }

    private void CancelarEdicion()
    {
        // Se cierra el formulario y se olvida la edición, nada se guarda.
        clienteEdicion = null;
        StateHasChanged();
    }

    private async Task DarDeBajaCliente(Cliente cliente)
    {
        bool seguro = await JS.InvokeAsync<bool>("confirm", $"¿Seguro que desea eliminar a {cliente.Nombre}?");

        // Si el usuario presiona "Cancelar", 'seguro' será false y el código se detiene aquí
        if (!seguro) return;

        try
        {
            // Elimina el cliente directamente
            db.Clientes.Remove(cliente);
            await db.SaveChangesAsync();

            // Se recarga la lista.
            await CargarClientes();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al dar de baja al cliente: {ex.Message}");
        }
    }
}
