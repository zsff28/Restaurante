@page "/reservar"

<form>
    <label for="nombre">Nombre:</label>
    <input type="text" id="nombre" required>

    <label for="fecha">Fecha:</label> <!-- Fecha y hora. Es una reservación, lleva fecha y hora. -->
    <input type="datetime" id="fecha" required>

    <label for="total">Valor estimado de consumo:</label> <!-- Fecha y hora. Es una reservación, lleva fecha y hora. -->
    <input type="number" id="total">

    <button type="submit">Enviar</button>
</form>

