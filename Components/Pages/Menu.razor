<!-- PANTALLA TERMINADA Y FUNCIONAL -->

@page "/menu"
@inject HttpClient Http
@using Restaurante.Models

<main class="menu-ocean-screen py-5">
    <div class="container">

        <div class="text-center mb-5">
            <span class="menu-subtitle">Experiencia Culinaria</span>
            <h1 class="menu-main-title">La Carta</h1>
            <div class="menu-divider"></div>
        </div>

        @if (products == null || categorias == null)
        {
            <div class="spinner-container text-center">
                <p>Cargando menú...</p>
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {
            @foreach (var cat in categorias)
            {
                // Agrega a la lista platillos cuando se cumpla la condición del Where. p es un producto individual de la lista product (de la API). Si la categoría del producto coincide con el id de la categoría actual se guarda en la lista. 
                var platillosDeEstaCategoria = products.Where(p => p.CategoriaId == cat.Id).ToList();

                // Verifica que la lista tenga elementos
                if (platillosDeEstaCategoria.Any())
                {
                    <section class="menu-category-section mb-5">
                        <h2 class="category-title">@cat.Nombre</h2>

                        <div class="row g-4">

                            @foreach (var platillo in platillosDeEstaCategoria)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <!-- Comprueba que el platillo esté disponible. Si es true, no agrega ninguna clase, sino agrega la clase disabled -->
                                    <div class="menu-item-card @(platillo.Disponible ? "" : "item-disabled")">

                                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                                            <h3 class="item-name">@platillo.Nombre</h3>
                                            <span class="item-price">$ @platillo.Precio</span>
                                        </div>

                                        <p class="item-description">
                                            @platillo.Descripcion
                                        </p>

                                        <div class="item-meta-specs d-flex gap-3 mt-3">
                                            <span class="spec-tag">
                                                <i class="bi bi-fire"></i> @platillo.Calorias kcal
                                            </span>

                                            @if (platillo.Disponible)
                                            {
                                                <span class="status-badge status-online">
                                                    <i class="bi bi-circle-fill"></i> Disponible
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-offline">
                                                    <i class="bi bi-dash-circle"></i> Agotado
                                                </span>
                                            }
                                        </div>

                                    </div>
                                </div>
                            }

                        </div>
                    </section>
                }
            }
        }

    </div>
</main>

@code {
    private List<Productos_API>? products;       // ← null al inicio, se llena después
    private List<Categorias_API>? categorias;       // ← null al inicio, se llena después

    // Se ejecuta automáticamente al cargar la página
    protected override async Task OnInitializedAsync()
    {
        try
        {
            //Pruebas cuando API no está disponible. Comentar cuando ya esté disponible.
            string urlProductos = "https://localhost:7244/data/platillos.json";
            string urlCategorias = "https://localhost:7244/data/categorias.json";

            //APIs a descomentar cuando estén disponibles.
            //string urlProductos = $"https://api-udec-pweb-aedec9hxbugye0am.westus3-01.azurewebsites.net/api/alimentacion/platillos";
            //string urlCategorias = $"https://api-udec-pweb-aedec9hxbugye0am.westus3-01.azurewebsites.net/api/alimentacion/categorias";

            products = await Http.GetFromJsonAsync<List<Productos_API>>(urlProductos);
            categorias = await Http.GetFromJsonAsync<List<Categorias_API>>(urlCategorias);
        }
        catch (Exception ex)
        {
            // Manejo de errores por si alguna de las dos APIs falla
            Console.WriteLine($"Error al recuperar los datos: {ex.Message}");
        }
    }
}
