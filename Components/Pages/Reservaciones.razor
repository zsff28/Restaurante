@page "/reservaciones"
@rendermode InteractiveServer
@using Restaurante.Data
@using Restaurante.Models
@inject RestauranteDbContext db

<div class="container-fluid px-4 py-5">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="view-title m-0">Libro de Reservaciones</h1>
            <p class="view-subtitle text-muted m-0">Gestión de accesos y mesas del Yacht Club</p>
        </div>
    </div>

    <div class="orizon-table-card">
        <div class="table-responsive">
            <table class="table orizon-table align-middle">
                <thead>
                    <tr>
                        <th scope="col" style="width: 10%;">ID</th>
                        <th scope="col" style="width: 25%;">Cliente (ID)</th>
                        <th scope="col" style="width: 20%;">Fecha y Hora</th>
                        <th scope="col" style="width: 15%;">Total Consumo</th>
                        <th scope="col" style="width: 15%;">Estado</th>
                        <th scope="col" style="width: 15%;" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (listaReservaciones == null || !listaReservaciones.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No hay reservaciones registradas.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var res in listaReservaciones)
                        {
                            <tr>
                                <td><span class="table-id-badge">#@res.Id</span></td>
                                <td>
                                    <div class="client-name">
                                        @(res.Cliente != null ? res.Cliente.Nombre : "Cliente no asignado")
                                    </div>
                                </td>
                                <td class="table-date">
                                    @res.Fecha.ToString("dd MMM yyyy")
                                    <span class="table-time">@res.Fecha.ToString("HH:mm") hrs</span>
                                </td>
                                <td class="table-total">
                                    $@((res.Total ?? 0).ToString("N2")) <span class="currency-tag">MXN</span>
                                </td>
                                <td>
                                    @if (res.Estado.ToLower() == "confirmada")
                                    {
                                        <span class="status-badge status-confirmed">@res.Estado</span>
                                    }
                                    else if (res.Estado.ToLower() == "cancelada")
                                    {
                                        <span class="status-badge status-cancelled">@res.Estado</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge bg-secondary">@res.Estado</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="action-buttons-group">
                                        <button class="btn-action-edit" title="Editar Reservación" @onclick="() => IniciarEdicion(res)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn-action-delete" title="Eliminar Reservación" @onclick="() => EliminarReservacion(res)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (reservacionEdicion != null)
{
    <div class="orizon-edit-card mt-3 mb-5">

        <div class="edit-card-header d-flex align-items-center mb-4">
            <div class="header-indicator"></div>
            <div>
                <h3 class="edit-card-title m-0">Modificar Reservación Activa</h3>
                <p class="edit-card-subtitle m-0 text-muted">Actualizando parámetros de acceso en el sistema</p>
            </div>
        </div>

        <form autocomplete="off" @onsubmit="GuardarEdicion">
            <div class="row g-4">

                <div class="col-md-6">
                    <label for="editCliente" class="orizon-label">Nombre del Cliente</label>
                    <div class="orizon-input-wrapper">
                        <i class="bi bi-person-badge orizon-icon-left"></i>
                        <input type="text" id="editCliente" class="orizon-control control-active"
                            value="@(reservacionEdicion.Cliente?.Nombre ?? "Sin asignar")" readonly disabled>
                    </div>
                </div>

                <div class="col-md-6">
                    <label for="editFecha" class="orizon-label">Fecha y Hora de Arribo</label>
                    <div class="orizon-input-wrapper">
                        <i class="bi bi-clock-history orizon-icon-left"></i>
                        <input type="datetime-local" id="editFecha" class="orizon-control control-active"
                            @bind-value="reservacionEdicion.Fecha" required>
                    </div>
                </div>

                <div class="col-md-6">
                    <label for="editTotal" class="orizon-label">Total Consumo Previsto</label>
                    <div class="orizon-input-wrapper">
                        <span class="orizon-currency-prefix">$</span>
                        <input type="number" id="editTotal" class="orizon-control currency-padding control-active"
                            @bind-value="reservacionEdicion.Total" step="100.0" required>
                        <span class="orizon-currency-suffix">MXN</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label for="editEstado" class="orizon-label">Estado de la Reserva</label>
                    <div class="orizon-input-wrapper">
                        <i class="bi bi-shield-check orizon-icon-left"></i>
                        <select id="editEstado" class="orizon-control-select control-active" @bind="reservacionEdicion.Estado" required>
                            <option value="Confirmada">Confirmada</option>
                            <option value="Cancelada">Cancelada</option>
                        </select>
                        <i class="bi bi-chevron-down orizon-icon-right"></i>
                    </div>
                </div>

            </div>

            <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top border-light">
                <button type="button" class="btn-orizon-cancel" @onclick="CancelarEdicion">
                    Descartar
                </button>
                <button type="submit" class="btn-orizon-save">
                    <i class="bi bi-cloud-arrow-up-fill me-2"></i> Guardar Cambios
                </button>
            </div>
        </form>
    </div>
}


@code {
    // Variable de control para el formulario de edición
    private Reservacion? reservacionEdicion = null;
    
    private List<Reservacion> listaReservaciones = [];

    protected override async Task OnInitializedAsync()
    {
        await CargarReservaciones();
    }

    private async Task CargarReservaciones()
    {
        // Cargamos rastreando los objetos normales, pero incluyendo la tabla Cliente
        listaReservaciones = await db.Reservaciones.Include(r => r.Cliente).ToListAsync();
    }

    // Este método se debe vincular al botón de la fila de tu tabla: @onclick="() => IniciarEdicion(res)"
    private void IniciarEdicion(Reservacion res)
    {
        // Clonamos para proteger la UI de ediciones fantasma si el usuario cancela
        reservacionEdicion = new Reservacion
        {
            Id = res.Id,
            ClienteId = res.ClienteId,
            Cliente = res.Cliente, // Mantenemos la referencia al cliente para el input readonly
            Fecha = res.Fecha,
            Total = res.Total,
            Estado = res.Estado
        };
    }

    private async Task GuardarEdicion()
    {
        if (reservacionEdicion != null)
        {
            try
            {
                // Buscamos la entidad original rastreada en el contexto por su ID
                var original = await db.Reservaciones.FindAsync(reservacionEdicion.Id);
                
                if (original != null)
                {
                    // Traspasamos los valores modificados del formulario al registro original
                    original.Fecha = reservacionEdicion.Fecha;
                    original.Total = reservacionEdicion.Total;
                    original.Estado = reservacionEdicion.Estado;

                    // Guardamos cambios de forma segura
                    await db.SaveChangesAsync();
                }

                // Cerramos formulario y refrescamos la tabla
                reservacionEdicion = null;
                await CargarReservaciones();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al guardar edición de reserva: {ex.Message}");
            }
        }
    }

    private void CancelarEdicion()
    {
        // Simplemente destruimos la copia temporal, cerrando el formulario de inmediato
        reservacionEdicion = null;
        StateHasChanged();
    }

    private async Task EliminarReservacion(Reservacion res)
    {
        db.Reservaciones.Remove(res);
        await db.SaveChangesAsync();
        await CargarReservaciones(); // Actualiza la tabla automáticamente
    }
}